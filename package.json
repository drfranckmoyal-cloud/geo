{
  "name": "drfranckmoyal-fr",
  "private": true,
  "version": "0.1.0",
  "description": "Site professionnel du Dr Franck Moyal — golden master (3 pages)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "images": "node scripts/prepare-images.mjs",
    "verify": "node scripts/verify-texts.mjs",
    "captures": "node scripts/captures.mjs",
    "check": "astro build && node scripts/verify-texts.mjs",
    "launch-check": "node scripts/check-launch.mjs",
    "paquet": "mkdir -p livrables/deploiement && cd dist && zip -qr -X -FS ../livrables/deploiement/drfranckmoyal-site.zip . && ls -l ../livrables/deploiement/drfranckmoyal-site.zip"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "node-html-parser": "^9.0.4",
    "playwright-core": "^1.63.0",
    "potrace": "^2.1.8"
  }
}
