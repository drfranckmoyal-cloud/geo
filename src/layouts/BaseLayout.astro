---
// Mise en page commune : informations pour les moteurs (titre, description, adresse de
// référence, données structurées), polices hébergées sur le site, en-tête et pied de page.
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/inter";
import "../styles/tokens.css";
import "../styles/global.css";
import newsreader from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import SiteHeader from "../components/global/SiteHeader.astro";
import SiteFooter from "../components/global/SiteFooter.astro";
import { site } from "../content/site";

interface Props {
  title: string;
  description: string;
  path: string;
  schema: unknown;
  ogImage?: string;
  robots?: string; // ex. « noindex,follow » (mentions légales)
}
const { title, description, path, schema, ogImage, robots } = Astro.props;
const canonical = new URL(path, site.url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site.url).href} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf8f3" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <SiteHeader />
    <main id="contenu">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Apparitions discrètes au défilement (V10) ; rien ne bouge si le visiteur a demandé
      // moins d'animations.
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
