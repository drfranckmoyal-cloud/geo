---
// Les pages du pack « pages suivantes » V1 (docs/pages-suivantes/v1) : un seul gabarit,
// alimenté par les fichiers du pack — textes lus tels quels (src/lib/pack.ts) — et assemblé
// avec les composants gelés du golden master (verrou V24), dans l'ordre du contrat de
// composants de chaque fichier : ouverture clinique, réponse directe, sections, FAQ, sources,
// auteur, pages liées, appel final.
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ClinicalHero from "../components/clinical/ClinicalHero.astro";
import DirectAnswer from "../components/clinical/DirectAnswer.astro";
import ClinicalPathway from "../components/clinical/ClinicalPathway.astro";
import FAQAccordion from "../components/clinical/FAQAccordion.astro";
import SourceList from "../components/clinical/SourceList.astro";
import RelatedPages from "../components/clinical/RelatedPages.astro";
import TextImageSection from "../components/editorial/TextImageSection.astro";
import AuthorBlock from "../components/editorial/AuthorBlock.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import MethodSteps from "../components/home/MethodSteps.astro";
import Container from "../components/global/Container.astro";
import PrimaryButton from "../components/global/PrimaryButton.astro";
import MediaFrame from "../components/ui/MediaFrame.astro";
import PackBlocks from "../components/pack/PackBlocks.astro";
import CasClinique from "../components/clinical/CasClinique.astro";
import { casCliniques } from "../content/cas-cliniques";
import portrait from "../assets/photos/portrait-franck.jpg";
import { home } from "../content/home";
import { usures } from "../content/usures";
import { site } from "../content/site";
import { hidden, layouts, schemaExtras, schemaOrganizations, shownSourceNotes } from "../content/pages-suivantes";
import { builtPackPages, crumbTrail, resolveLink } from "../lib/pack-files";
import { planSections } from "../lib/pack-layout";
import { contractFacts, type PackPage } from "../lib/pack";
import { abs, breadcrumbs, faqPage, graph, organization, person, practice, website } from "../lib/schema";

export function getStaticPaths() {
  return builtPackPages().map((page) => ({ params: { slug: page.url.replace(/^\/|\/$/g, "") }, props: { page } }));
}

const { page } = Astro.props as { page: PackPage };
const cfg = layouts[page.num] ?? {};
const masked = hidden[page.num] ?? [];
const resolve = (label: string) => resolveLink(page, label);

// Passages non affichés (consignes glissées dans le texte, à confirmer par ChatGPT)
const sections = page.sections
  .filter((s) => !masked.some((h) => h.section === s.title))
  .map((s) => ({ ...s, blocks: s.blocks.filter((b) => !(b.kind === "p" && masked.some((h) => h.text && b.text.startsWith(h.text)))) }))
  // Liste de noms de pages en gras (page Contact, « Motifs de consultation ») : des liens
  .map((s) =>
    cfg.sections?.[s.id]?.links
      ? { ...s, blocks: s.blocks.flatMap((b) => (b.kind === "ul" ? b.items.map((item) => ({ kind: "evidence" as const, label: item.replace(/^\*\*|\*\*$/g, ""), href: resolve(item.replace(/^\*\*|\*\*$/g, "")) })) : [b])) }
      : s,
  );
const plans = planSections(sections, cfg.sections, cfg.defaults);

// Boutons d'une section, décidés par ChatGPT (page Contact : appeler ou écrire, correctif V1.3) :
// le bouton principal du golden master, côte à côte, d'égale importance
const actionsOf = (id: string) => cfg.sections?.[id]?.actions ?? [];

// Cas cliniques d'une section, sous son texte. Une photographie seule reste dans la colonne de
// lecture ; un avant / après et une séquence prennent la largeur du site, juste après la section.
const casOf = (id: string) => [cfg.sections?.[id]?.cas ?? []].flat();
const casDansTexte = (id: string) => (casOf(id).length === 1 && casCliniques[casOf(id)[0]]?.type === "image" ? casOf(id) : []);
const casPleineLargeur = (id: string) => (casDansTexte(id).length ? [] : casOf(id));

const trail = crumbTrail(page);
const og = await getImage({ src: portrait, format: "jpg", width: 800 });
const facts = contractFacts(page.contract);
// Ligne auteur de l'ouverture : absente quand le fichier ne nomme pas d'auteur (Contact, Mentions légales)
const byline = page.author.name && !cfg.hideByline ? { label: page.author.name, href: page.author.href } : undefined;
const hasAuthor = facts.authorBlock;

// Sources : notes du §10 à afficher ; renvois du texte dont le numéro n'est pas dans la liste
// (ils mènent au bloc des sources ; l'écart est signalé par le contrôle des textes)
// Une note s'affiche par sa première ligne, suivie de l'adresse web qui l'accompagne le cas échéant
// (seule, ou précédée de son nom : « EUR-Lex : https://… ») ; les lignes de consigne (« À présenter
// comme… ») ne le sont jamais.
const notes = page.sourceNotes.flatMap((para) => {
  const lines = para.split("\n");
  if (!(shownSourceNotes[page.num] ?? []).some((start) => lines[0].startsWith(start))) return [];
  return [/^(?:[^:]+ : )?https?:\/\/\S+$/.test(lines[1] ?? "") ? `${lines[0]}\n${lines[1]}` : lines[0]];
});
const allText = [page.lead, page.answer ?? "", ...sections.flatMap((s) => s.blocks.map((b) => JSON.stringify(b))), ...(page.faq?.items.map((i) => i.a) ?? [])].join("\n");
const listed = new Set(page.sources.map((s) => s.n));
const firstCited = [...allText.replace(/\*\*/g, "").matchAll(/\s\[(\d+)/g)].map((m) => Number(m[1]));
const orphans = [...new Set(firstCited)].filter((n) => !listed.has(n));

// Pages liées : celles que le contrat impose, sinon la liste « À lire aussi » du fichier, sinon ses
// liens internes à câbler — sans le lien de rendez-vous, une seule fois par page de destination.
const isRdv = (href: string) => href === site.rdv.href || href.startsWith("/contact/#");
const once = (items: { label: string; href: string }[]) => items.filter((it, i) => items.findIndex((o) => o.href === it.href) === i);
const related = facts.relatedLabels.length
  ? { title: "À lire aussi", items: facts.relatedLabels.map((label) => ({ label, href: resolve(label) })) }
  : page.related
    ? { title: page.related.title, items: page.related.labels.map((label) => ({ label, href: resolve(label) })) }
    : page.links.length
      ? { title: "À lire aussi", items: once(page.links.filter((l) => l.href !== page.url && !isRdv(l.href))) }
      : undefined;

// Données structurées : types du §8 de chaque fichier
const pageTypes = page.seo.schema.filter((t) => /Page$/.test(t) || t === "Article");
const url = abs(page.url);
const schema = graph([
  website(),
  {
    "@type": pageTypes.length === 1 ? pageTypes[0] : pageTypes,
    "@id": `${url}#page`,
    url,
    name: page.seo.title,
    description: page.seo.description,
    inLanguage: site.lang,
    isPartOf: { "@id": site.websiteId },
    ...(pageTypes.includes("Article") ? { headline: page.h1 } : {}),
    author: { "@id": site.personId },
    ...(page.parent === "/franck-moyal/" ? { about: { "@id": site.personId } } : {}),
    dateModified: page.author.iso,
    breadcrumb: { "@id": `${url}#fil` },
    ...(page.sources.length
      ? {
          citation: page.sources.map((s) => ({
            "@type": "ScholarlyArticle",
            name: s.title,
            author: s.authors,
            datePublished: s.year,
            isPartOf: { "@type": "Periodical", name: s.journal.replace(/\.$/, "") },
            ...(s.doi ? { sameAs: `https://doi.org/${s.doi}` } : {}),
            url: s.pubmed,
          })),
        }
      : {}),
    ...(schemaExtras[page.num] ?? {}),
  },
  { ...breadcrumbs(trail.map((c) => ({ name: c.label, path: c.href }))), "@id": `${url}#fil` },
  person(abs(og.src), false, page.seo.schema.includes("PostalAddress")),
  practice(),
  ...(page.faq ? [faqPage(url, page.faq.items)] : []),
  ...(schemaOrganizations[page.num] ?? []).map(organization),
]);
---

<BaseLayout title={page.seo.title} description={page.seo.description} path={page.url} schema={schema} ogImage={og.src} robots={page.seo.robots}>
  <ClinicalHero breadcrumbs={trail} h1={page.h1} lead={page.lead} byline={byline} />
  {page.answer && <DirectAnswer text={page.answer} />}
  {cfg.pathway && <ClinicalPathway items={plans.map((p) => ({ label: p.section.title, href: `#${p.id}` }))} />}

  {
    plans.map((p) => (
      <>
        {cfg.method?.before === p.section.id && <MethodSteps title={facts.methodTitle ?? home.method.title} steps={home.method.steps} />}
        {p.aside.length > 0 ? (
          <TextImageSection id={p.id} title={p.section.title} layout={p.layout} tone={p.tone}>
            <PackBlocks blocks={p.main} resolve={resolve} etapes={p.etapes} />
            {
              actionsOf(p.section.id).length > 0 && (
                <div class="pack-actions">
                  {actionsOf(p.section.id).map((a) => (
                    <PrimaryButton href={a.href} label={a.label} />
                  ))}
                </div>
              )
            }
            <PackBlocks slot="aside" blocks={p.aside} resolve={resolve} narrow class="pack-aside" />
          </TextImageSection>
        ) : (
          <TextImageSection
            id={p.id}
            title={p.section.title}
            layout={p.layout}
            tone={p.tone}
            media={p.media && !p.media.wide ? { label: p.media.label, ratio: p.media.ratio } : undefined}
          >
            <PackBlocks blocks={p.main} resolve={resolve} entries={p.entries} etapes={p.etapes} narrow={p.layout.startsWith("split")} />
            {
              actionsOf(p.section.id).length > 0 && (
                <div class="pack-actions">
                  {actionsOf(p.section.id).map((a) => (
                    <PrimaryButton href={a.href} label={a.label} />
                  ))}
                </div>
              )
            }
            {casDansTexte(p.section.id).map((id) => <CasClinique id={id} class="pack-cas-seul" />)}
            {p.media?.wide && <MediaFrame label={p.media.label} ratio={p.media.ratio} class="pack-wide-media" />}
          </TextImageSection>
        )}
        {casPleineLargeur(p.section.id).length > 0 && (
          <Container class:list={["pack-cas", casPleineLargeur(p.section.id).length > 1 && "pack-cas--duo"]}>
            {casPleineLargeur(p.section.id).map((id) => (
              <CasClinique id={id} />
            ))}
          </Container>
        )}
      </>
    ))
  }

  {
    page.faq && (
      <FAQAccordion
        title={page.faq.title}
        items={page.faq.items.map((i) => ({ ...i, links: i.links?.map((label) => ({ label, href: resolve(label) })) }))}
      />
    )
  }
  {
    page.sources.length > 0 && (
      <SourceList
        title={usures.sources.title}
        intro={usures.sources.intro}
        toggle={`Voir les ${page.sources.length} sources scientifiques`}
        items={page.sources}
        notes={notes}
        orphans={orphans}
      />
    )
  }
  {
    hasAuthor && (
      <Container class="grid-12 pack-author">
        <div class="pack-author__block">
          <AuthorBlock
            label={usures.author.label}
            name={page.author.name}
            tagline={usures.author.tagline}
            updated={`Mis à jour le ${page.author.date}`}
            updatedIso={page.author.iso}
            href={page.author.href}
            image={portrait}
          />
        </div>
      </Container>
    )
  }
  {related && <RelatedPages label={related.title} items={related.items} />}
  {page.cta && <FinalCTA title={page.cta.title} text={page.cta.paragraphs} cta={page.cta.label ?? cfg.cta?.label} href={cfg.cta?.href} />}
</BaseLayout>

<style>
  /* Cas clinique sous le texte d'une section : pleine largeur de la colonne de lecture, deux cas
     côte à côte lorsque la section en présente deux */
  /* Photographie seule : dans la colonne de lecture, sous le texte de la section */
  :global(.pack-cas-seul) {
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }
  /* Avant / après et séquences : largeur du site, juste sous la section */
  :global(.pack-cas) {
    margin-top: clamp(-1rem, -2rem + 2vw, 0rem);
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  :global(.pack-cas--duo) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--col-gap);
    align-items: start;
  }
  @media (max-width: 47.99em) {
    :global(.pack-cas--duo) {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  /* Tableau comparatif (POINT 2) : la section est en colonne de lecture, calée sur le bord
     gauche ; le tableau, lui, prend toute la largeur du site pour respirer. */
  :global(.pb__table) {
    width: min(100vw - 2 * var(--gutter), var(--container));
  }

  /* Emplacement d'image en pleine largeur sous une grille (schéma de la page Usures) */
  :global(.pack-wide-media) {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    width: min(100vw - 2 * var(--gutter), var(--container));
  }
  /* Boutons d'une section : l'écart texte → bouton des appels finaux */
  .pack-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--gap-text-cta);
  }
  /* Liste en colonne latérale : sans l'écart titre → texte */
  :global(.pack-aside) {
    margin-top: 0;
  }
  /* Bloc auteur : même place que sur la page Usures */
  :global(.pack-author) {
    padding-bottom: 1rem;
  }
  .pack-author__block {
    grid-column: 6 / span 7;
  }
  @media (max-width: 63.99em) {
    .pack-author__block {
      grid-column: 1 / -1;
    }
  }
</style>
