---
// Les deux piliers (07 §7) : deux territoires majeurs, pas deux cartes de services.
// Grands titres, texte court, visuel, lien sobre ; le second pilier est décalé vers le bas.
import Section from "../global/Section.astro";
import EditorialH2 from "../global/EditorialH2.astro";
import BodyText from "../global/BodyText.astro";
import TextLink from "../global/TextLink.astro";
import MediaFrame from "../ui/MediaFrame.astro";
import { plain } from "../../lib/typo";

interface Pillar {
  title: string;
  text: string;
  cta: { label: string; href: string };
  media: string;
}
interface Props {
  title: string;
  items: Pillar[];
}
const { title, items } = Astro.props;
---

<Section labelledby="piliers-titre">
  <div class="container">
    <EditorialH2 id="piliers-titre" text={title} class="pillars__title" />
    <div class="grid-12 pillars">
      {
        items.map((item, i) => (
          <article class:list={["pillar", `pillar--${i + 1}`]} data-reveal>
            <MediaFrame label={item.media} ratio="4 / 3" />
            <h3 class="pillar__title" set:html={plain(item.title)} />
            <BodyText paragraphs={item.text} class="pillar__text" />
            <TextLink href={item.cta.href} label={item.cta.label} />
          </article>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .container :global(.pillars__title) {
    max-width: 22ch;
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .pillar--1 {
    grid-column: 1 / span 5;
  }
  .pillar--2 {
    grid-column: 7 / span 5;
    margin-top: clamp(4rem, 2rem + 6vw, 8rem);
  }
  .pillar__title {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-sage);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .pillar :global(.pillar__text) {
    margin-top: 1.25rem;
    margin-bottom: 1.75rem;
  }

  @media (max-width: 47.99em) {
    .pillar--1,
    .pillar--2 {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .pillar--2 {
      margin-top: 4rem;
    }
  }
</style>
