---
// Appel final (08 C : « CTA final net ») : un titre, une phrase, un bouton. Sert aux trois
// pages. Le bouton mène à la prise de rendez-vous (provisoirement la section « Prendre rendez-vous »
// de la page Contact, D41) ; l'ancre #rendez-vous n'est plus utilisée.
import Section from "../global/Section.astro";
import EditorialH2 from "../global/EditorialH2.astro";
import BodyText from "../global/BodyText.astro";
import PrimaryButton from "../global/PrimaryButton.astro";
import { site } from "../../content/site";

interface Props {
  title: string;
  text?: string | string[];
  cta?: string;
  href?: string; // par défaut : l'emplacement réservé de la prise de rendez-vous (D8)
}
const { title, text, cta, href = site.rdv.href } = Astro.props;
const hasText = Array.isArray(text) ? text.length > 0 : Boolean(text);
---

<Section tone="ivory" id="appel-final" labelledby="appel-final-titre">
  <div class="container grid-12">
    <div class="final" data-reveal>
      <EditorialH2 id="appel-final-titre" text={title} size="statement" />
      {hasText && <BodyText paragraphs={text!} class="final__text" />}
      {cta && <PrimaryButton href={href} label={cta} class={hasText ? undefined : "final__cta--seul"} />}
    </div>
  </div>
</Section>

<style>
  .final {
    grid-column: 3 / span 8;
  }
  .final :global(.final__text) {
    max-width: 36rem;
    margin-block: var(--gap-title-text) var(--gap-text-cta);
  }
  .final :global(.final__cta--seul) {
    margin-top: var(--gap-text-cta);
  }
  @media (max-width: 63.99em) {
    .final {
      grid-column: 1 / -1;
    }
  }
</style>
