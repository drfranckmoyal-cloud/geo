---
// Petite étiquette au-dessus d'un titre : capitales espacées, vert sauge, précédée d'un filet.
import { plain } from "../../lib/typo";

interface Props {
  text: string;
  class?: string;
}
const { text, class: cls } = Astro.props;
---

<p class:list={["eyebrow", cls]} set:html={plain(text)} />

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
    font-size: var(--fs-meta);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .eyebrow::before {
    content: "";
    flex: none;
    width: 1.75rem;
    height: 1px;
    background: currentColor;
  }
</style>
