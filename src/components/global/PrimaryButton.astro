---
// Bouton principal (V9) : fond noir doux, texte blanc cassé, 52 px, coins de 3 px, sans relief.
// La taille « header » (42 px) sert uniquement dans l'en-tête, qui doit rester fin.
import { linkAttrs } from "../../lib/links";

interface Props {
  href: string;
  label: string;
  size?: "default" | "header";
  class?: string;
}
const { href, label, size = "default", class: cls } = Astro.props;
---

<a href={href} class:list={["btn", size === "header" && "btn--header", cls]} {...linkAttrs(href)}>{label}</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-h);
    padding: 0 1.875rem;
    background: var(--c-ink);
    color: var(--c-paper);
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--t-hover) var(--ease);
  }
  .btn:hover {
    background: var(--c-sage);
  }
  .btn--header {
    min-height: var(--btn-h-header);
    padding: 0 1.25rem;
    font-size: var(--fs-meta);
  }
</style>
