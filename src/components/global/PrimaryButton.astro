---
// Bouton principal (V9) : fond noir doux, texte blanc cassé, 52 px, coins de 3 px, sans relief.
// La taille « header » (42 px) sert uniquement dans l'en-tête, qui doit rester fin ; sur petit
// téléphone, elle peut afficher un libellé court, le nom complet restant lu par les lecteurs
// d'écran (D33).
import { linkAttrs } from "../../lib/links";

interface Props {
  href: string;
  label: string;
  size?: "default" | "header";
  shortLabel?: string;
  class?: string;
}
const { href, label, size = "default", shortLabel, class: cls } = Astro.props;
---

<a
  href={href}
  class:list={["btn", size === "header" && "btn--header", cls]}
  aria-label={shortLabel ? label : undefined}
  {...linkAttrs(href)}
>
  {
    shortLabel ? (
      <>
        <span class="btn__full">{label}</span>
        <span class="btn__short" aria-hidden="true">{shortLabel}</span>
      </>
    ) : (
      label
    )
  }
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-h);
    padding: 0 1.875rem;
    background: var(--c-ink);
    color: var(--c-paper);
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    max-width: 100%;
    transition: background-color var(--t-hover) var(--ease);
  }
  /* Petit écran : un libellé long passe sur deux lignes plutôt que de déborder de la page
     (audit du 24/09/2026). La hauteur s'adapte, la zone tactile reste confortable. */
  @media (max-width: 47.99em) {
    .btn:not(.btn--header) {
      white-space: normal;
      height: auto;
      padding: 0.9375rem 1.5rem;
      line-height: 1.35;
    }
  }
  .btn:hover {
    background: var(--c-sage);
  }
  .btn--header {
    min-height: var(--btn-h-header);
    padding: 0 1.25rem;
    font-size: var(--fs-meta);
  }
  .btn__short {
    display: none;
  }
  @media (max-width: 27.49em) {
    .btn--header .btn__full {
      display: none;
    }
    .btn--header .btn__short {
      display: inline;
    }
  }
</style>
