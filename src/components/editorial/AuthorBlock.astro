---
// Auteur identifié (00 §10, 08 E) : nom, titre et lien vers la page de Franck — textes repris
// de la page Franck, aucun texte nouveau.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import TextLink from "../global/TextLink.astro";
import { plain } from "../../lib/typo";

interface Props {
  label: string;
  name: string;
  role: string;
  text: string;
  link: { label: string; href: string };
  image: ImageMetadata;
}
const { label, name, role, text, link, image } = Astro.props;
---

<aside class="author" aria-label={label}>
  <Picture
    src={image}
    alt=""
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    widths={[96, 192]}
    sizes="6rem"
    class="author__photo"
  />
  <div class="author__body">
    <p class="author__label">{label}</p>
    <p class="author__name">{name}</p>
    <p class="author__role">{role}</p>
    <p class="author__text" set:html={plain(text)} />
    <TextLink href={link.href} label={link.label} />
  </div>
</aside>

<style>
  .author {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.75rem;
    align-items: start;
    padding-top: 2rem;
    border-top: 1px solid var(--c-stone);
  }
  .author :global(.author__photo) {
    width: 6rem;
    height: 6rem;
    object-fit: cover;
  }
  .author__label {
    font-size: var(--fs-meta);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .author__name {
    margin-top: 0.5rem;
    font-family: var(--f-serif);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.15;
  }
  .author__role {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }
  .author__text {
    max-width: 34rem;
    margin-block: 1rem 1.25rem;
    font-size: var(--fs-small);
  }
</style>
