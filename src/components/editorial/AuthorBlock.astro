---
// Auteur identifié (00 §10, 08 E), en bloc court (D20) : nom et titre (lien vers la page de
// Franck), une ligne de domaines, la date de mise à jour.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { plain } from "../../lib/typo";

interface Props {
  label: string;
  name: string;
  tagline: string;
  updated: string;
  updatedIso: string;
  href: string;
  image: ImageMetadata;
}
const { label, name, tagline, updated, updatedIso, href, image } = Astro.props;
// « Mis à jour le 21 septembre 2026 » : la date est balisée pour les moteurs
const [updatedPrefix, updatedDate] = updated.split(/ le (?=\d)/);
---

<aside class="author" aria-label={label}>
  <Picture
    src={image}
    alt=""
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    widths={[96, 192]}
    sizes="4.5rem"
    class="author__photo"
  />
  <div class="author__body">
    <p class="author__label">{label}</p>
    <p class="author__name"><a href={href} set:html={plain(name)} /></p>
    <p class="author__tagline" set:html={plain(tagline)} />
    <p class="author__updated">{updatedPrefix} le <time datetime={updatedIso}>{updatedDate}</time></p>
  </div>
</aside>

<style>
  .author {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.5rem;
    align-items: start;
    padding-top: 2rem;
    border-top: 1px solid var(--c-stone);
  }
  .author :global(.author__photo) {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    object-position: 50% 28%;
  }
  .author__label {
    font-size: var(--fs-meta);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .author__name {
    margin-top: 0.5rem;
    font-family: var(--f-serif);
    font-size: 1.5rem;
    font-weight: var(--fw-display);
    line-height: 1.2;
  }
  .author__name a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--t-hover) var(--ease);
  }
  .author__name a:hover {
    text-decoration-color: currentColor;
  }
  .author__tagline {
    margin-top: 0.35rem;
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--c-ink-soft);
  }
  .author__updated {
    margin-top: 0.75rem;
    font-size: var(--fs-meta);
    color: var(--c-ink-soft);
  }
</style>
