---
// Liste clinique (signes, axes, outils) : une légende discrète, des lignes séparées par des
// filets, deux colonnes sur grand écran. Aucune icône. La légende est facultative : les listes
// du pack « pages suivantes » sont annoncées par la phrase qui les précède.
import { rich } from "../../lib/typo";

interface Props {
  label?: string;
  items: string[];
  columns?: 1 | 2;
  class?: string;
}
const { label, items, columns = 2, class: cls } = Astro.props;
---

<div class:list={["symptoms", cls]}>
  {label && <p class="symptoms__label">{label}</p>}
  <ul class:list={["symptoms__list", columns === 2 && "symptoms__list--two"]}>
    {items.map((item) => <li set:html={rich(item)} />)}
  </ul>
</div>

<style>
  .symptoms__label {
    margin-bottom: 0.75rem;
    font-size: var(--fs-meta);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .symptoms__list li {
    padding-block: 0.8rem;
    border-top: 1px solid var(--c-stone);
    line-height: 1.45;
  }
  .symptoms__list--two {
    columns: 2;
    column-gap: var(--col-gap);
  }
  .symptoms__list--two li {
    break-inside: avoid;
  }
  @media (max-width: 47.99em) {
    .symptoms__list--two {
      columns: 1;
    }
  }
</style>
