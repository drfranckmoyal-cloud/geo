---
// Sources scientifiques (verrous V22, D19) : les références restent toutes dans la page (HTML),
// citation propre, DOI et PubMed discrets (rel="noopener noreferrer"), une ancre par référence
// pour les renvois [1]…[7]. Les notes de travail « Soutient : » ne sont pas affichées.
// Sur mobile, la liste se replie derrière « Voir les 7 sources scientifiques ».
// Pages suivantes : notes du pack affichées sous la liste (documentation d'un logiciel, repère
// clinique) ; date de vérification facultative ; un renvoi du texte sans référence dans la liste
// mène au bloc des sources (écart signalé par le contrôle des textes).
import Section from "../global/Section.astro";
import EditorialH2 from "../global/EditorialH2.astro";
import { plain, rich } from "../../lib/typo";

interface Source {
  n: number;
  authors: string;
  title: string;
  journal: string;
  details: string;
  doi: string;
  pubmed: string;
}
interface Props {
  id?: string;
  title: string;
  intro: string;
  toggle: string;
  items: Source[];
  verifiedLabel?: string;
  verifiedDate?: string;
  verifiedIso?: string;
  notes?: string[];
  orphans?: number[];
}
const { id = "sources", title, intro, toggle, items, verifiedLabel, verifiedDate, verifiedIso, notes = [], orphans = [] } = Astro.props;
// Un numéro présent deux fois dans le pack : seule sa première occurrence porte l'ancre
const anchored = new Set<number>();
const anchor = (n: number) => (anchored.has(n) ? undefined : (anchored.add(n), `source-${n}`));
---

<Section id={id} labelledby={`${id}-titre`} spacing="compact">
  <div class="container grid-12 sources">
    <div class="sources__head">
      <EditorialH2 id={`${id}-titre`} text={title} />
      <p class="sources__intro" set:html={plain(intro)} />
    </div>
    <div class="sources__body">
      <details class="sources__details" open data-sources>
        <summary class="sources__toggle">
          <span>{toggle}</span>
          <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.1" />
          </svg>
        </summary>
        {orphans.map((n) => <span id={`source-${n}`} />)}
        <ol class="sources__list">
          {
            items.map((s) => (
              <li id={anchor(s.n)} class="source">
                <span class="source__n">[{s.n}]</span>
                <div>
                  <p class="source__ref">
                    <strong>{s.authors}</strong> {s.title} <em>{s.journal}</em> {s.details}
                  </p>
                  <p class="source__links">
                    <a href={`https://doi.org/${s.doi}`} target="_blank" rel="noopener noreferrer">
                      DOI : {s.doi}
                    </a>
                    <a href={s.pubmed} target="_blank" rel="noopener noreferrer">
                      PubMed
                    </a>
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </details>
      {notes.map((note) => <p class="sources__note" set:html={rich(note)} />)}
      {
        verifiedLabel && (
          <p class="sources__verified">
            {verifiedLabel}&nbsp;: <time datetime={verifiedIso}>{verifiedDate}</time>
          </p>
        )
      }
    </div>
  </div>
</Section>

<script>
  // Repli sur mobile ; ouvert partout ailleurs, et partout si JavaScript est absent.
  const details = document.querySelector<HTMLDetailsElement>("[data-sources]");
  if (details && window.matchMedia("(max-width: 47.99em)").matches) details.open = false;
  // Un renvoi [n] cliqué alors que la liste est repliée : on l'ouvre.
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#source-"]').forEach((a) =>
    a.addEventListener("click", () => {
      if (details) details.open = true;
    }),
  );
</script>

<style>
  .sources {
    align-items: start;
    padding-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-top: 1px solid var(--c-stone);
  }
  .sources__head {
    grid-column: 1 / span 4;
  }
  .sources__intro {
    margin-top: 1.25rem;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }
  .sources__body {
    grid-column: 6 / span 7;
  }
  .sources__toggle {
    display: none;
  }
  .source {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--c-stone);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .source:last-child {
    border-bottom: 1px solid var(--c-stone);
  }
  .source__n {
    color: var(--c-sage);
    font-weight: 500;
  }
  .source__ref strong {
    font-weight: 600;
  }
  .source__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.35rem;
    font-size: var(--fs-meta);
  }
  .source__links a {
    color: var(--c-sage);
    text-decoration-color: var(--c-sage-light);
  }
  .source__links a:hover {
    text-decoration-color: currentColor;
  }
  .sources__note {
    margin-top: 1.25rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--c-ink-soft);
  }
  .sources__note :global(a) {
    color: var(--c-sage);
    text-decoration-color: var(--c-sage-light);
    overflow-wrap: anywhere;
  }
  .sources__verified {
    margin-top: 1.5rem;
    font-size: var(--fs-meta);
    color: var(--c-ink-soft);
  }

  @media (max-width: 63.99em) {
    .sources__head,
    .sources__body {
      grid-column: 1 / -1;
    }
    .sources__body {
      margin-top: 2rem;
    }
  }
  @media (max-width: 47.99em) {
    .sources__toggle {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-block: 1rem;
      border-top: 1px solid var(--c-stone);
      border-bottom: 1px solid var(--c-stone);
      font-size: var(--fs-small);
      font-weight: 500;
      list-style: none;
      cursor: pointer;
    }
    .sources__toggle::-webkit-details-marker {
      display: none;
    }
    .sources__toggle svg {
      width: 0.75rem;
      height: 0.45rem;
    }
    .sources__details[open] .sources__toggle svg {
      transform: scaleY(-1);
    }
    .sources__details[open] .sources__list .source:first-child {
      border-top: 0;
    }
  }
</style>
