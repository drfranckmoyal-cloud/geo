# drfranckmoyal.fr — hébergement Hostinger.
# Une seule adresse de référence, celle des balises « canonical » : https://drfranckmoyal.fr/
# (sans « www »). Les visites en http:// ou sur www. y sont redirigées définitivement.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://drfranckmoyal.fr%{REQUEST_URI} [L,R=301]

# Le serveur d'Hostinger ne connaît pas le format AVIF : il envoie ces images
# étiquetées « texte », et certains navigateurs refusent alors de les afficher
# (constaté le 26/09/2026 sur le portrait). On déclare les deux formats d'images
# modernes utilisés par le site.
AddType image/avif .avif
AddType image/webp .webp
